# Copy to .env for local development. In production, set these through your
# platform / secret manager instead of a file. Never commit real values.
# Everything is validated at startup (src/config/env.validation.ts): the app
# refuses to start and lists every problem if something is missing or wrong.

# --- Runtime ------------------------------------------------------------
NODE_ENV=development            # production enables stricter checks + JSON logs
PORT=3000
# Number of proxies in front of the app (load balancer = 1). Empty locally.
TRUST_PROXY=
# json | text. Default: json when NODE_ENV=production, otherwise text.
LOG_FORMAT=

# --- Database -----------------------------------------------------------
# Production: connect as the least-privilege role from prisma/sql/app-role.sql,
# and run migrations separately with the owner role.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniapp_gateway?schema=public

# --- Payments -----------------------------------------------------------
PAYMENT_PROVIDER=mock           # mock | mpesa-miniapp (mock is refused in production)
PAYMENT_MAX_TTL_MINUTES=30      # longest expiresAt the main backend may ask for

# --- Main backend → gateway (inbound HMAC, docs/service-auth.md) --------
# key id → secret. Generate each secret with: openssl rand -base64 48
SERVICE_HMAC_KEYS='{"main-backend-2026":"<secret>"}'

# --- Gateway → main backend (events, Task 5) ----------------------------
MAIN_BACKEND_EVENTS_URL=http://localhost:4000/v1/gateway/events   # https in production
EVENT_HMAC_KEY=<different secret: openssl rand -base64 48>
EVENT_CLIENT_ID=miniapp-gateway # sent as X-Client-Id on events (optional)

# --- Background jobs (outbox dispatcher + reconciler) -------------------
BACKGROUND_JOBS=on              # on | off

# --- M-Pesa Mini App (only when PAYMENT_PROVIDER=mpesa-miniapp) ---------
MP_BASE_URL=https://<safaricom open api host>
MP_CLIENT_ID=
MP_MERCHANT_ID=
MP_APP_ID=
PUBLIC_BASE_URL=https://<this gateway's public host>   # Safaricom calls /payments/notify here
# Keys: EITHER the PEM itself (from a secret manager; "\n" escapes allowed)...
MP_PRIVATE_KEY=
MP_PLATFORM_PUBLIC_KEY=
# ...OR a file path (local dev, or a secret mounted outside the project folder).
MP_PRIVATE_KEY_PATH=keys/private.pem
MP_PLATFORM_PUBLIC_KEY_PATH=keys/public.pem
